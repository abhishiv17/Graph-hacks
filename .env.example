# Ask KindRed's model. "groq" is hosted and fast (free key at console.groq.com, set GROQ_API_KEY).
# "ollama" runs a local model for free (install Ollama, then: ollama pull llama3.1:8b).
# "anthropic" uses Claude and needs ANTHROPIC_API_KEY. Leave empty to use whichever key is set, otherwise Ollama.
KINDRED_ASK_PROVIDER=ollama
GROQ_API_KEY=
KINDRED_GROQ_MODEL=openai/gpt-oss-120b
# Each Groq model has its own rate limit: when one is busy, the next one here is tried.
KINDRED_GROQ_FALLBACK=openai/gpt-oss-20b
# Optional. Sarvam voices and translation for the "Explain this graph" walkthroughs (dashboard.sarvam.ai).
SARVAM_API_KEY=
KINDRED_OLLAMA_MODEL=llama3.1:8b
# Where the backend finds Ollama. The Docker default reaches Ollama on your machine; for a local backend use localhost.
# OLLAMA_URL=http://localhost:11434

# Optional. Claude for Ask KindRed, and translation of family messages beyond English and Hindi.
ANTHROPIC_API_KEY=

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
