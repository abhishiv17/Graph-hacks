# Ask KindRed's model. "ollama" runs a local model for free (install Ollama, then: ollama pull llama3.1:8b).
# "anthropic" uses Claude and needs ANTHROPIC_API_KEY. Leave empty to use Claude when a key is set, otherwise Ollama.
KINDRED_ASK_PROVIDER=ollama
KINDRED_OLLAMA_MODEL=llama3.1:8b
# Where the backend finds Ollama. The Docker default reaches Ollama on your machine; for a local backend use localhost.
# OLLAMA_URL=http://localhost:11434

# Optional. Claude for Ask KindRed, and translation of family messages beyond English and Hindi.
ANTHROPIC_API_KEY=

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
